# Copia a .env en el servidor. Solo SITE y DOMAIN son necesarios para docker compose;
# el resto activa y acota el chat alojado (véase README, «Como servidor HTTP o contenedor»).
SITE=datosabiertos
DOMAIN=datosabiertos.sejas.es
OPENROUTER_API_KEY=
TFM_MODELO_CHAT=meta/muse-spark-1.3-contributor
TFM_CHAT_LIMITE_IP=20
TFM_CHAT_VENTANA=600
TFM_CHAT_LIMITE_DIA=500
